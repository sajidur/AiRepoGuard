{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://airepoguard/url-policy.schema.json",
  "title": "URL/Domain monitoring and blocking policy",
  "type": "object",
  "required": ["version", "monitor", "block"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monitorAction": { "type": "string", "enum": ["Audit", "Warn", "Allowed"] },
        "blockAction": { "type": "string", "enum": ["Block", "Warn", "BlockAndRemediate"] }
      }
    },
    "monitor": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "block": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["domain"],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "description": "Domain or wildcard (e.g. example.com or *.example.com). A full URL is accepted and reduced to its host.",
          "pattern": "^(\\*\\.)?[A-Za-z0-9._:/-]+$"
        },
        "category": { "type": "string" },
        "reason": { "type": "string" },
        "action": {
          "type": "string",
          "description": "Optional per-entry override of the list default action.",
          "enum": ["Audit", "Warn", "Allowed", "Block", "BlockAndRemediate"]
        }
      }
    }
  }
}
